# Base ROMs and anything extracted from them are never committed: all of orig/ (the base ROM, the BIOS, the other
# games' ROMs that the Pokédex's Flavour reads at build time), and ROMs and saves of any kind anywhere
/orig
*.nds
*.srl
*.dsi
*.gb
*.gbc
*.gba
*.sav
*.dsv
extract/
/extract
/build/

# Tools downloaded or built by configure
tools/dsd
tools/dsd.rev
tools/src/
tools/objdiff-cli
tools/wibo
tools/sjiswrap.exe
tools/mwccarm

.venv
__pycache__/
build.ninja
.ninja_*
objdiff.json

# Claude Code: per-session state; the project's skills, agents, hooks and settings.json are committed
.claude/worktrees/
.claude/settings.local.json
.claude/audit-state.json
!.claude/settings.json
paperwhite2.local
