{
  "name": "paperwhite-editor",
  "private": true,
  "version": "0.1.0",
  "description": "The Paper White 2 editor: edits res/ in place, from its schemas, and builds the ROM",
  "type": "module",
  "scripts": {
    "start": "vite build --logLevel warn && tsx server/main.ts",
    "dev": "concurrently -k -n server,web \"tsx watch server/main.ts --dev\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.3"
  }
}
