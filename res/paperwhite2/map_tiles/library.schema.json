{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Map tile library",
    "description": "A library of tiles for the Map Editor, cut from the game's map chunks by tools/paperwhite2/map_tiles.py (docs/paperwhite2/design/map-editor.md). The catalogue it makes is in build/map_tiles/<library>/.",
    "type": "object",
    "required": [ "name", "sources" ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "name": {
            "type": "string",
            "description": "The library's name in the editor."
        },
        "sources": {
            "type": "array",
            "description": "The map model folders (res/field/maps/models/) whose tiles the library holds.",
            "items": {
                "type": "string"
            }
        },
        "tiles": {
            "type": "object",
            "description": "The user's settings of tiles, by key.",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "hidden": {
                        "type": "boolean",
                        "description": "Left out of the palette."
                    }
                }
            }
        }
    }
}
