{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "A map style: res/paperwhite2/map_styles/<style>.json",
    "description": "The terrains the Map Editor's map maker paints with, each its look from a vanilla area's texture set and its tile type (tools/paperwhite2/map_maker.py).",
    "type": "object",
    "additionalProperties": false,
    "required": [ "name", "texture_set", "terrains", "wall" ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "This schema, for editors"
        },
        "name": {
            "type": "string"
        },
        "texture_set": {
            "type": "string",
            "x-constant": "MAP_TEXTURE_SET_",
            "description": "The set its textures come from, which the generated chunk binds to"
        },
        "wall": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "texture" ],
            "properties": {
                "texture": {
                    "type": "string",
                    "description": "A PNG of the style's texture set, without .png"
                },
                "repeat": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Tiles a repeat of the texture spans"
                },
                "alpha": {
                    "enum": [ "MASK", "BLEND" ],
                    "description": "How its transparent pixels draw"
                }
            },
            "description": "The wall between heights where neither terrain has one: a cliff, v down it"
        },
        "edges": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [ "to", "lines", "faces" ],
                "properties": {
                    "to": {
                        "type": "string",
                        "description": "The key of the terrain whose border this is: its band lies inside its tiles"
                    },
                    "from": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "The terrains across the border, at the same height, that the band is drawn against; without it, any other terrain at any height (a riverbank)"
                    },
                    "lines": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [ "offset", "lift" ],
                            "properties": {
                                "offset": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1,
                                    "description": "Tiles in from the border"
                                },
                                "lift": {
                                    "type": "number",
                                    "description": "Tiles above the terrain's height"
                                }
                            }
                        },
                        "description": "The profile's lines, from the border in"
                    },
                    "inner": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The line the terrain's own ground starts at, at its lift (else the last)"
                    },
                    "faces": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [ "between", "texture" ],
                            "properties": {
                                "between": {
                                    "type": "array",
                                    "items": {
                                        "type": "integer",
                                        "minimum": 0
                                    },
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "description": "The two lines the face lies between"
                                },
                                "texture": {
                                    "type": "string",
                                    "description": "A PNG of the style's texture set, without .png"
                                },
                                "v": {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "description": "v at the first line and at the second; u runs along the border"
                                },
                                "planar": {
                                    "type": "boolean",
                                    "description": "Textured from above like the ground instead (u, v = x, z over the repeat)"
                                },
                                "repeat": {
                                    "type": "number",
                                    "exclusiveMinimum": 0,
                                    "description": "Tiles a repeat of the texture spans"
                                },
                                "alpha": {
                                    "enum": [ "MASK", "BLEND" ],
                                    "description": "How its transparent pixels draw"
                                }
                            }
                        },
                        "description": "The faces between the lines, drawn in this order"
                    },
                    "points": {
                        "type": "boolean",
                        "description": "Bend straight borders half a tile in at every third tile, alternating sides, as the game's paths do"
                    },
                    "tile_type": {
                        "type": "integer",
                        "description": "The collision tile type of the band's tiles (a riverbank's); else the terrain's"
                    }
                }
            },
            "description": "Borders drawn inside a terrain's outer tiles, as profiles along them (tools/paperwhite2/map_edges.py): a path's grass edge, a riverbank"
        },
        "terrains": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [ "key", "name", "ground", "tile_type" ],
                "properties": {
                    "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1,
                        "description": "Its letter in a project's terrain rows"
                    },
                    "name": {
                        "type": "string"
                    },
                    "color": {
                        "type": "string",
                        "description": "Its color in the editor's painting view"
                    },
                    "ground": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [ "texture" ],
                        "properties": {
                            "texture": {
                                "type": "string",
                                "description": "A PNG of the style's texture set, without .png"
                            },
                            "repeat": {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "description": "Tiles a repeat of the texture spans"
                            },
                            "alpha": {
                                "enum": [ "MASK", "BLEND" ],
                                "description": "How its transparent pixels draw"
                            }
                        },
                        "description": "The ground, textured from above"
                    },
                    "layers": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [ "texture", "lift" ],
                            "properties": {
                                "texture": {
                                    "type": "string",
                                    "description": "A PNG of the style's texture set, without .png"
                                },
                                "repeat": {
                                    "type": "number",
                                    "exclusiveMinimum": 0,
                                    "description": "Tiles a repeat of the texture spans"
                                },
                                "alpha": {
                                    "enum": [ "MASK", "BLEND" ],
                                    "description": "How its transparent pixels draw"
                                },
                                "lift": {
                                    "type": "number",
                                    "description": "Units above the ground (a tile is 16)"
                                }
                            }
                        },
                        "description": "Planes above the ground: tall grass's blades"
                    },
                    "wall": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [ "texture" ],
                        "properties": {
                            "texture": {
                                "type": "string",
                                "description": "A PNG of the style's texture set, without .png"
                            },
                            "repeat": {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "description": "Tiles a repeat of the texture spans"
                            },
                            "alpha": {
                                "enum": [ "MASK", "BLEND" ],
                                "description": "How its transparent pixels draw"
                            }
                        },
                        "description": "The wall down to it from a higher tile (a riverbank), before the style's"
                    },
                    "tile_type": {
                        "type": "integer",
                        "description": "Its collision's tile type: TILE_CLASS_ and flags (include/field/field_map.h)"
                    }
                }
            }
        }
    }
}
