                {
                    "name": "top",
                    "title": "Top screen",
                    "chars": "res/graphics/copyright/01.png",
                    "screen": "res/graphics/copyright/02.nscr"
                },
                {
                    "name": "touch",
                    "title": "Touch screen",
                    "chars": "res/graphics/copyright/03.png",
                    "screen": "res/graphics/copyright/04.nscr"
                }
            ]
        },
        {
            "name": "boot_extra",
            "title": "Screen after the copyright",
            "description": "Paper White 2's own boot screen, after the copyright notice, which A, B or Start skips (src/ov162/boot_screens.c). While its palette is all black it is skipped, so it stays off until it has art.",
            "palette": "res/graphics/copyright/09.pal",
            "colors": 256,
            "depth": 4,
            "max_tiles": 1024,
            "screens": [
                {
                    "name": "top",
                    "title": "Top screen",
                    "chars": "res/graphics/copyright/10.png",
                    "screen": "res/graphics/copyright/11.nscr"
